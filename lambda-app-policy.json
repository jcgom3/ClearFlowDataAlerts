{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3UploadsBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::clearflow-data-alerts-uploads-jcgom3/*"
    },
    {
      "Sid": "AllowDynamoDBAppTableAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:Scan",
        "dynamodb:Query",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:497206384701:table/clearflow-data-alerts"
    }
  ]
}
